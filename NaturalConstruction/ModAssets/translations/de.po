#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALBACKWALL.DESC
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALBACKWALL.DESC"
msgid "Very natural, much wow."
msgstr "In der Tat, äußerst natürlich das ganze."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALBACKWALL.EFFECT
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALBACKWALL.EFFECT"
msgid ""
"Creates a natural backwall on finishing construction.\n"
"Mass can be configured during construction."
msgstr ""
"Erzeugt eine Naturrückwand bei Fertigstellung der Konstruction.\n"
"Die Masse kann während des Baus konfiguriert werden."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALBACKWALL.NAME
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALBACKWALL.NAME"
msgid "<link=\"NCNATURALBACKWALL\">Natural Backwall</link>"
msgstr "<link=\"NCNATURALBACKWALL\">Naturrückwand</link>"

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTER.DESC
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTER.DESC"
msgid "Very natural, much wow."
msgstr "In der Tat, äußerst natürlich das ganze."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTER.EFFECT
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTER.EFFECT"
msgid ""
"Allows selecting a single seed to be wild planted.\n"
"Will also create a natural tile on seed planting.\n"
"Tile mass can be configured during construction."
msgstr ""
"Ermöglicht die Auswahl eines einzelnen Samens, der wild gepflanzt werden soll.\n"
"Erzeugt beim Pflanzen des Seeds zudem einen natürlichen Ziegel.\n"
"Die Masse des Ziegels kann während des Baus konfiguriert werden."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTER.NAME
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTER.NAME"
msgid "<link=\"NCNATURALPLANTER\">Wild Planting Tile</link>"
msgstr "<link=\"NCNATURALPLANTER\">Wild-Pflanz-Ziegel</link>"

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERBACKWALL.DESC
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERBACKWALL.DESC"
msgid "Very natural, much wow."
msgstr "In der Tat, äußerst natürlich das ganze."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERBACKWALL.EFFECT
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERBACKWALL.EFFECT"
msgid ""
"Allows selecting a single large backwall-planted seed to be wild planted.\n"
"Will also create 4 natural backwalls on seed planting.\n"
"total backwall mass can be configured during construction."
msgstr ""
"Ermöglicht die Auswahl eines einzelnen in eine Rückwand gepflanzten Samens, der wild "
"gepflanzt werden soll.\n"
"Erzeugt außerdem 4 natürliche Rückwände beim Pflanzen des Samens.\n"
"Die Gesamtmasse der Rückwände kann während des Baus konfiguriert werden."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERBACKWALL.NAME
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERBACKWALL.NAME"
msgid "<link=\"NCNATURALPLANTERBACKWALL\">Wild Planting Backwall</link>"
msgstr "<link=\"NCNATURALPLANTERBACKWALL\">Wild-Pflanz-Rückwand</link>"

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERWIDE.DESC
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERWIDE.DESC"
msgid "Very natural, much wow."
msgstr "In der Tat, äußerst natürlich das ganze."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERWIDE.EFFECT
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERWIDE.EFFECT"
msgid ""
"Allows selecting a single large seed to be wild planted.\n"
"Will also create three natural tiles on seed planting.\n"
"Total tile mass can be configured during construction."
msgstr ""
"Ermöglicht die Auswahl eines einzelnen großen Samens, der wild gepflanzt werden soll.\n"
"Erzeugt beim Pflanzen des Samens außerdem drei natürliche Ziegel.\n"
"Die Gesamtmasse der natürlichen Ziegel kann während des Baus konfiguriert werden."

#. NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERWIDE.NAME
msgctxt "NaturalConstruction.STRINGS.BUILDINGS.PREFABS.NC_NATURALPLANTERWIDE.NAME"
msgid "<link=\"NCNATURALPLANTERWIDE\">Wide Wild Planting Tile</link>"
msgstr "<link=\"NCNATURALPLANTERWIDE\">Breiter Wild-Pflanz-Ziegel</link>"

